# Production Environment Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or Self-Hosted)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_face_attendance?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai_face_attendance

# Authentication Secrets (Generate strong 64-char strings)
JWT_SECRET=production_faculty_jwt_secret_change_me_with_openssl_rand_hex_64
QR_SECRET=production_qr_session_jwt_secret_change_me_with_openssl_rand_hex_64

# Microservice Connection
AI_SERVICE_URL=http://127.0.0.1:5001

# Geofencing Configuration (GPS coordinates of your college/university campus)
CAMPUS_LAT=12.9716
CAMPUS_LNG=77.5946
CAMPUS_RADIUS_METERS=500

# Attendance Rules
DEFAULT_SESSION_DURATION_MINUTES=10

# Security (CORS)
# Set to your frontend domain in production (e.g. https://attendance.yourcollege.edu)
CORS_ORIGIN=*
